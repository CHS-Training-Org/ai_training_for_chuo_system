<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="工程と役割分担">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 工程の見出し -->
        <mxCell id="2" value="① 試験観点" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="3" value="② 試験ケース" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="4" value="③ テストコード" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="5" value="④ 実行" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="20" width="200" height="26" as="geometry" />
        </mxCell>
        <!-- 学習者のレーン -->
        <mxCell id="6" value="学習者" style="swimlane;startSize=30;horizontal=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="仕様を読み、&#xa;何を確認するか決める" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E293B;arcSize=8;fontStyle=1" vertex="1" parent="6">
          <mxGeometry x="90" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8" value="展開結果を&#xa;一覧で確認する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E293B;arcSize=8;" vertex="1" parent="6">
          <mxGeometry x="310" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="生成されたコードを&#xa;確認する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E293B;arcSize=8;" vertex="1" parent="6">
          <mxGeometry x="530" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="10" value="実装の不具合かを&#xa;判断する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E293B;arcSize=8;fontStyle=1" vertex="1" parent="6">
          <mxGeometry x="750" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <!-- AI のレーン -->
        <mxCell id="11" value="AI" style="swimlane;startSize=30;horizontal=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="1000" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="観点の洗い出しを&#xa;補助する（スキル）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1E293B;arcSize=8;" vertex="1" parent="11">
          <mxGeometry x="90" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="13" value="試験ケースへ&#xa;展開する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1E293B;arcSize=8;" vertex="1" parent="11">
          <mxGeometry x="310" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="テストコードを&#xa;生成する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1E293B;arcSize=8;" vertex="1" parent="11">
          <mxGeometry x="530" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="15" value="実行し、失敗を&#xa;切り分けて直す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1E293B;arcSize=8;" vertex="1" parent="11">
