        <mxCell id="18" value="テストデータの準備と後片付け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#334155;fontColor=#1E293B;arcSize=8;" vertex="1" parent="16">
          <mxGeometry x="530" y="74" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="19" value="運営者が用意する&#xa;（学習者は意識しない）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#475569;" vertex="1" parent="16">
