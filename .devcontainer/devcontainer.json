{
  "name": "BookFlow Full Stack",
  "dockerComposeFile": "docker-compose.yml",
  "service": "frontend",
  "workspaceFolder": "/workspace",
  // Claude Code 未起動だとホストに ~/.claude.json が存在せず、Docker がマウント元を
  // 空ディレクトリとして自動生成 → ファイル↔ディレクトリの型衝突でコンテナ起動が失敗する。
  // マウント前にホスト側で空ファイルの存在を保証して回避する。
  // （.claude ディレクトリはホスト共有をやめコンテナ専用 named volume に隔離したため、
  //   ホスト側の mkdir は不要になった。docker-compose.yml の claude-config を参照。）
  // initializeCommand はホストのシェルで実行される（WSL2/Linux/macOS は /bin/sh）。
  // そのため POSIX sh で記述する。Windows で開発する場合は WSL2 経由で起動すること
  // （README の「Windows ユーザー向け: WSL2 セットアップ」を参照）。
  //
  // 2つの処理を `;` で連結している:
  // (1) ~/.claude.json の空ファイル事前生成（型衝突回避。上のコメント参照）。
  // (2) Rancher Desktop / WSL2 の bind mount 残骸を掃除する（scripts/clean-devcontainer-mounts.sh）。
  //     Rancher バックエンドが異常終了すると docker-mounts 配下に「非空の proxy ディレクトリ」の
  //     残骸が残り、次回 `docker compose up` が munger の rmdir 失敗（"directory not empty"）で
  //     起動できなくなる。スクリプトが非空の残骸のみを安全に削除する（判別ロジックの詳細と
  //     安全性はスクリプト内コメント参照）。Rancher Desktop 以外では no-op。`|| true` で起動を止めない。
  "initializeCommand": "[ -f \"$HOME/.claude.json\" ] || printf '{}' > \"$HOME/.claude.json\"; sh \"${localWorkspaceFolder}/scripts/clean-devcontainer-mounts.sh\" || true",
  "features": {
    // Java feature は devcontainer-lock.json で 1.8.2 以降に固定する。
    // 1.8.1 以前の install.sh は、バージョン解決の正規表現が SDKMAN の識別子に含まれる
    // ビルド番号（例: 25.0.5.0+8-tem の +8）に一致せず、
    // "Version 25 not found. Available versions:"（空）で exit 1 していた。
    // 8 月（PR #86）は当時 + を含まなかった tem へ切り替えて回避したが、
    // その後 Temurin の識別子にも + が付き、同じ失敗が再発した（Issue #159）。
    // 1.8.2 で上流が正規表現を修正済み（devcontainers/features#1714）のため、
    // 識別子の + の有無には依存しない。jdkDistro は最新の JDK が入る tem のまま据え置く。
    "ghcr.io/devcontainers/features/java:1": { "version": "25", "jdkDistro": "tem" },
    "ghcr.io/devcontainers/features/node:2.0.0": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // ホストの ~/.claude / ~/.claude.json のバインドは docker-compose.yml の frontend サービスへ
  // long-form 構文で定義している（compose 構成では devcontainer.json の mounts(短縮形)だと
  // Windows のドライブレターを含むパスが Docker のボリューム parser に弾かれるため）。
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-ja",
        // Java 関連は Extension Pack for Java に集約。redhat.java / vscode-java-test /
        // vscode-gradle 等を内包するため、個別指定で起きる「依存先(redhat.java)が未インストール」
        // のインストール順序レースを回避できる。
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker",
        "Anthropic.claude-code",
        "hediet.vscode-drawio"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
      }
    }
  },
  "forwardPorts": [3000, 8000, 8080, 3130],
  "portsAttributes": {
    "3130": {
      "label": "結合テストのダッシュボード",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "WAYLAND_DISPLAY": "",
    "DISPLAY": "",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh"
}
